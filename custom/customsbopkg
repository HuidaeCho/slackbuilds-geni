#!/bin/sh
custom=$(dirname $(realpath $0))
[ -d "$CUSTOMSBOPKG_PATH" ] && custom="$CUSTOMSBOPKG_PATH"
if [ ! -d "$custom/../custom" ]; then
	echo "Please check customsbopkg repository"
	exit
fi

cleanup(){
	rm -f $tmp
}
trap cleanup EXIT
tmp=/tmp/customsbo.$$

first=1
for i in $(find $custom -type d ! -name .git ! -empty -mindepth 1 -maxdepth 1 -printf "%f\n"); do
	c=$custom/$i
	s=$(find /var/lib/sbopkg/SBo-git -type d -name $i)
	[ "$s" = "" ] && continue
	if [ -f $c/$i.SlackBuild.sbopkg ]; then
		cver=$(sed '/^VERSION=/!d; s/.*:-\|}.*//g' $c/$i.SlackBuild.sbopkg)
		sver=$(sed '/^VERSION=/!d; s/.*:-\|}.*//g' $s/$i.SlackBuild)
		printf "%s\n" $sver $cver | sort -VC || {
			[ $first -eq 0 ] || first=0
			echo "$i: skipped (sbopkg version is newer)"
			continue
		}
	fi
	patch=
	for f in $(find $c ! -name README.md -mindepth 1 -maxdepth 1 -printf "%f\n"); do
		if [ -d $c/$f ]; then
			if [ -d $s/$f ]; then
				for g in $(find $c/$f -type f -mindepth 1 -maxdepth 1 -printf "%f\n"); do
					if [ -f $s/$f/$g ]; then
						diff=$(diff $c/$f/$g $s/$f/$g)
						[ "$diff" = "" ] || {
							[ $first -eq 0 ] || first=0
							diff=$(echo "$diff" | sed 's/^/  /')
							printf "diff $c/$f/$g $s/$f/$g\n$diff\n"
						}
					else
						cp -a $c/$f/$g $s/$f
						echo "$s/$f/$g copied"
					fi
				done
			else
				cp -a $c/$f $s
				echo "$s/$f copied"
			fi
			continue
		elif [ -f $s/$f ]; then
			diff=$(diff $c/$f $s/$f)
			[ "$diff" = "" ] || {
				[ $first -eq 0 ] || first=0
				diff=$(echo "$diff" | sed 's/^/  /')
				printf "diff $c/$f $s/$f\n$diff\n"
			}
		else
			cp -a $c/$f $s
			echo "$s/$f copied"
		fi
		echo $f | grep -q "\.patch$" || continue
		grep -q $f $s/$i.SlackBuild && continue
		pat="patch -p0 < \$CWD/$f"
		if [ "$patch" = "" ]; then
			patch="$pat"
		else
			patch="$patch\n$pat"
		fi
	done
	[ -f $s/$i.SlackBuild.sbopkg -o "$patch" = "" ] && continue
	sed "/^cd \$PRGNAM-\$VERSION/a \\$patch" $s/$i.SlackBuild > $s/$i.SlackBuild.sbopkg
	echo "$s/$i.SlackBuild.sbopkg created with patches"
done
