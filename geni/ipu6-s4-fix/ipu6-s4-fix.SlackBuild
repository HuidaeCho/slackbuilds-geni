#!/bin/sh
# SlackBuild for the IPU6 camera S4 hibernation fix.
# Build patched LJCA kernel modules separately from Slackware's stock modules.
# Requires matching kernel sources and ljca-s4-fix.patch alongside this script.

set -eu

PRGNAM=ipu6-fix
KVER=${KVER:-$(uname -r)}
VERSION=${VERSION:-$(printf '%s' $KVER | tr '-' '_')}
ARCH=${ARCH:-$(uname -m)}
BUILD=${BUILD:-1}
TAG=${TAG:-_geni}

CWD=$(cd $(dirname $0) && pwd)
TMP=${TMP:-/tmp/geni}
OUTPUT=${OUTPUT:-/tmp}
WORK=$TMP/$PRGNAM-$KVER
PKG=$TMP/package-$PRGNAM-$KVER
SRC=${SRC:-/usr/src/linux-$KVER}
KBUILD=${KBUILD:-/lib/modules/$KVER/build}
JOBS=${JOBS:-4}

if [ ! -f $KBUILD/Makefile ]; then
    echo "Missing kernel build tree: $KBUILD" >&2
    exit 1
fi

rm -rf $WORK $PKG
mkdir -p $WORK $PKG $OUTPUT
cd $WORK

for file in \
    drivers/usb/misc/usb-ljca.c \
    drivers/i2c/busses/i2c-ljca.c \
    drivers/gpio/gpio-ljca.c \
    drivers/spi/spi-ljca.c
do
    if [ ! -f $SRC/$file ]; then
        echo "Missing kernel source: $SRC/$file" >&2
        exit 1
    fi
    mkdir -p $(dirname $file)
    cp $SRC/$file $file
done

patch -p1 < $CWD/ljca-s4-fix.patch

printf 'obj-m := usb-ljca.o\n' > drivers/usb/misc/Kbuild
printf 'obj-m := i2c-ljca.o\n' > drivers/i2c/busses/Kbuild
printf 'obj-m := gpio-ljca.o\n' > drivers/gpio/Kbuild
printf 'obj-m := spi-ljca.o\n' > drivers/spi/Kbuild

for dir in \
    drivers/usb/misc \
    drivers/i2c/busses \
    drivers/gpio \
    drivers/spi
do
    make -C $KBUILD M=$WORK/$dir -j$JOBS modules
done

BASE=$PKG/lib/modules/$KVER/updates/ljca-s4-fix
install -Dm644 drivers/usb/misc/usb-ljca.ko $BASE/usb-ljca.ko
install -Dm644 drivers/i2c/busses/i2c-ljca.ko $BASE/i2c-ljca.ko
install -Dm644 drivers/gpio/gpio-ljca.ko $BASE/gpio-ljca.ko
install -Dm644 drivers/spi/spi-ljca.ko $BASE/spi-ljca.ko

# Install the elogind S4 hook as a package-managed executable.
install -Dm755 $CWD/ipu6 $PKG/etc/elogind/system-sleep/ipu6

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
# Bind the dependency-index hooks to the kernel version built for this package.
sed "s|@KVER@|$KVER|g" $CWD/doinst.sh > $PKG/install/doinst.sh
sed "s|@KVER@|$KVER|g" $CWD/douninst.sh > $PKG/install/douninst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.tgz
