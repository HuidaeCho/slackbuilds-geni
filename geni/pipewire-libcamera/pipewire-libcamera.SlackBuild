#!/bin/sh
# SlackBuild for PipeWire's libcamera SPA plugin only.
# Uses the matching PipeWire source and the installed libcamera library.
# Does not replace Slackware's PipeWire package or build another libcamera.

PIPEWIRE_VERSION=$(pkg-config --modversion libpipewire-0.3)
LIBCAMERA_VERSION=$(pkg-config --modversion libcamera)
VERSION=${PIPEWIRE_VERSION}_${LIBCAMERA_VERSION}
SRCNAM=pipewire
SRC=$SRCNAM-$PIPEWIRE_VERSION

CWD=$(cd $(dirname $0) && pwd)
PRGNAM=${PRGNAM:-$(basename $0 | sed 's/\.SlackBuild$//')}
BUILD=${BUILD:-1}
TAG=${TAG:-_geni}
TMP=${TMP:-/tmp/geni}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i486;;
    arm*) ARCH=arm;;
    *) ARCH=$(uname -m);;
  esac
fi

if [ "$ARCH" = "i486" ]; then
  SLKCFLAGS="-O2 -march=i486 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$SRCNAM-$PIPEWIRE_VERSION.tar.?z
[ $SRC != $PRGNAM-$VERSION ] && mv $SRC $PRGNAM-$VERSION
cd $PRGNAM-$VERSION
chown -R root:root .
chmod -R u+w,go+r-w,a-s .

# Configure the full Meson project, but compile only the single SPA target.
# Refuse Meson dependency fallbacks: use the installed libcamera 0.8.x etc.
export CFLAGS="$SLKCFLAGS"
export CXXFLAGS="$SLKCFLAGS"
meson setup build \
  --prefix=/usr \
  --libdir=lib$LIBDIRSUFFIX \
  --buildtype=release \
  --wrap-mode=nofallback \
  -Dauto_features=disabled \
  -Dlibcamera=enabled \
  -Dsession-managers=[] \
  -Dexamples=disabled \
  -Dtests=disabled \
  -Ddocs=disabled \
  -Dman=disabled \
  -Dflatpak=disabled

sed -i \
 -e 's/properties::CameraLocationFront/properties::LocationFront/g' \
 -e 's/properties::CameraLocationBack/properties::LocationBack/g' \
 -e 's/properties::CameraLocationExternal/properties::LocationExternal/g' \
 spa/plugins/libcamera/libcamera-device.cpp

meson compile -C build spa-libcamera

install -Dm755 build/spa/plugins/libcamera/libspa-libcamera.so \
  $PKG/usr/lib$LIBDIRSUFFIX/spa-0.2/libcamera/libspa-libcamera.so

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz
